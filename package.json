{
 "name": "manuscrito",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "concurrently \"node server.js\" \"vite\"",
  "build": "vite build",
  "start": "node server.js",
  "test": "node --test test/*.test.js",
  "app": "node scripts/electron-native.mjs && electron .",
  "dist": "node scripts/build-info.mjs && node scripts/electron-native.mjs darwin arm64 x64 && vite build && electron-builder --mac dmg --arm64 --publish never && electron-builder --mac dmg --x64 --publish never",
  "dist:arm": "node scripts/build-info.mjs && node scripts/electron-native.mjs darwin arm64 && vite build && electron-builder --mac dmg --arm64 --publish never",
  "dist:intel": "node scripts/build-info.mjs && node scripts/electron-native.mjs darwin x64 && vite build && electron-builder --mac dmg --x64 --publish never",
  "native": "node scripts/electron-native.mjs"
 },
 "dependencies": {
  "@hocuspocus/extension-database": "^2.13.0",
  "@hocuspocus/server": "^2.13.0",
  "better-sqlite3": "^11.0.0",
  "dictionary-ca": "^3.0.0",
  "dictionary-de": "^3.0.0",
  "dictionary-en": "^4.0.0",
  "dictionary-en-gb": "^3.0.0",
  "dictionary-es": "^4.0.0",
  "dictionary-fr": "^3.0.0",
  "dictionary-it": "^2.0.0",
  "dictionary-pt": "^4.0.0",
  "dompurify": "^3.4.17",
  "express": "^4.19.0",
  "fflate": "^0.8.3",
  "katex": "^0.19.1",
  "marked": "^18.1.2",
  "nspell": "^2.1.5",
  "pdfjs-dist": "^6.4.299",
  "yjs": "^13.6.0"
 },
 "devDependencies": {
  "@codemirror/autocomplete": "^6.12.0",
  "@codemirror/language": "^6.10.0",
  "@codemirror/legacy-modes": "^6.4.0",
  "@codemirror/merge": "^6.7.0",
  "@codemirror/state": "^6.4.0",
  "@codemirror/view": "^6.26.0",
  "@lezer/highlight": "^1.2.0",
  "@hocuspocus/provider": "^2.13.0",
  "codemirror": "^6.0.1",
  "concurrently": "^8.2.0",
  "electron": "^33.4.11",
  "electron-builder": "^25.1.8",
  "vite": "^5.4.0",
  "y-codemirror.next": "^0.3.5"
 },
 "main": "electron/main.cjs",
 "ljtexRepo": "luisjorgesanchezsaldana/LJtex",
 "version": "1.0.0",
 "description": "LJtex: editor de LaTeX local",
 "author": "Luis Jorge Sánchez",
 "build": {
  "appId": "mx.ljtex.app",
  "productName": "LJtex",
  "asar": false,
  "npmRebuild": false,
  "directories": {
   "output": "release"
  },
  "files": [
   "electron/**",
   "server.js",
   "agent.js",
   "bibimport.js",
   "zotero.js",
   "github.js",
   "zipio.js",
   "datasync.js",
   "dist/**",
   "public/**",
   "native/**",
   "build-info.json",
   "package.json"
  ],
  "afterPack": "build/afterPack.cjs",
  "mac": {
   "category": "public.app-category.productivity",
   "icon": "build/icon.png",
   "identity": null,
   "target": [
    {
     "target": "dmg"
    }
   ],
   "artifactName": "LJtex-${version}-${arch}.${ext}"
  },
  "dmg": {
   "title": "LJtex"
  }
 }
}